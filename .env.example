# ─── LLM ──────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Embeddings (OpenAI text-embedding-3-small, 1536 dims) ──────────────────────
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ─── PostgreSQL (sessions + pgvector memory + runbooks + service catalog) ───────
# For DatabaseSessionService, use postgresql+asyncpg:// prefix
DATABASE_URL=postgresql+asyncpg://sre:sre@localhost:5432/sre_agent

# ─── Datadog ────────────────────────────────────────────────────────────────────────
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com

# ─── AWS ─────────────────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Databricks ───────────────────────────────────────────────────────────────────────
DATABRICKS_HOST=adb-xxxx.azuredatabricks.net
DATABRICKS_TOKEN=dapi...

# ─── Flink ──────────────────────────────────────────────────────────────────────────────
FLINK_JOBMANAGER_URL=http://flink-jm.flink.svc:8081

# ─── Slack ──────────────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_INCIDENT_CHANNEL=#sre-incidents

# ─── MCP Servers ──────────────────────────────────────────────────────────────────────
SPLUNK_MCP_URL=http://splunk-mcp:8080/sse
EKS_MCP_URL=http://eks-mcp:8080/sse
BITBUCKET_MCP_URL=http://bitbucket-mcp:8080/sse

# ─── OpenSearch (AST code index) ───────────────────────────────────────────────────
OPENSEARCH_URL=https://opensearch.internal:9200
OPENSEARCH_USERNAME=sre-agent
OPENSEARCH_PASSWORD=
OPENSEARCH_CODE_INDEX=platform-code-chunks

# ─── Code Agent (A2A) ──────────────────────────────────────────────────────────────────
CODE_AGENT_A2A_URL=http://code-agent:8080

# ─── OpenTelemetry (export to Datadog Agent or OTEL Collector) ─────────────────
OTEL_ENABLED=false
OTLP_ENDPOINT=http://localhost:4317

# ─── Alert deduplication ─────────────────────────────────────────────────────────────
ALERT_DEDUP_TTL_MINUTES=15

# ─── Proactive health check scheduler ───────────────────────────────────────────────
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_MINUTES=5

# ─── Webhook HMAC signature verification (optional) ─────────────────────────────
WEBHOOK_SECRET=
